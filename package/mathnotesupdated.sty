% Custom theorem styles using amsthm (colored bold text, no boxes)
\colorlet{defcolor}{DarkGoldenrod}
\colorlet{thmcolor}{MediumBlue}
\colorlet{excolor}{MediumVioletRed}
\colorlet{egcolor}{ForestGreen}
\colorlet{rmkcolor}{Indigo}

\newtheoremstyle{coloreddef}%
  {3pt}{3pt}%
  {\normalfont}%
  {}%
  {\color{defcolor}\bfseries}%
  {.}%
  {.5em}%
  {\thmname{#1}\thmnumber{ #2}\thmnote{ (#3)}}

\newtheoremstyle{coloredthm}%
  {3pt}{3pt}%
  {\itshape}%
  {}%
  {\color{thmcolor}\bfseries}%
  {.}%
  {.5em}%
  {\thmname{#1}\thmnumber{ #2}\thmnote{ (#3)}}

\newtheoremstyle{coloredex}%
  {3pt}{3pt}%
  {\normalfont}%
  {}%
  {\color{excolor}\bfseries}%
  {.}%
  {.5em}%
  {\thmname{#1}\thmnumber{ #2}\thmnote{ (#3)}}

\newtheoremstyle{coloredeg}%
  {3pt}{3pt}%
  {\normalfont}%
  {}%
  {\color{egcolor}\bfseries}%
  {.}%
  {.5em}%
  {\thmname{#1}\thmnumber{ #2}\thmnote{ (#3)}}

\newtheoremstyle{coloredrmk}%
  {3pt}{3pt}%
  {\normalfont}%
  {}%
  {\color{rmkcolor}\bfseries}%
  {.}%
  {.5em}%
  {\thmname{#1}\thmnumber{ #2}\thmnote{ (#3)}}

\theoremstyle{coloreddef}
\newtheorem{definition}{Definition}[section]

\theoremstyle{coloredthm}
\newtheorem{theorem}[definition]{Theorem}
\newtheorem{proposition}[definition]{Proposition}
\newtheorem{corollary}[definition]{Corollary}
\newtheorem{lemma}[definition]{Lemma}

\theoremstyle{coloredex}
\newtheorem{exercise}[definition]{Exercise}

\theoremstyle{coloredeg}
\newtheorem{example}[definition]{Example}

\theoremstyle{coloredrmk}
\newtheorem{remark}[definition]{Remark}

% Backwards-compatibility aliases for former box environment names
\newenvironment{definitionbox}[2][]{\begin{definition}[#2]}{\end{definition}}
\newenvironment{theorembox}[2][]{\begin{theorem}[#2]}{\end{theorem}}
\newenvironment{propbox}[2][]{\begin{proposition}[#2]}{\end{proposition}}
\newenvironment{lemmabox}[2][]{\begin{lemma}[#2]}{\end{lemma}}
\newenvironment{exercisebox}[2][]{\begin{exercise}[#2]}{\end{exercise}}
\newenvironment{examplebox}[2][]{\begin{example}[#2]}{\end{example}}
\newenvironment{remarkbox}[2][]{\begin{remark}[#2]}{\end{remark}}

% Custom quote environment for textbook/author quotes
\colorlet{quotebarcolor}{SteelBlue}
\newenvironment{textquote}[1][]{%
  \par\medskip
  \noindent
  \begin{list}{}{%
    \setlength{\leftmargin}{1.5em}%
    \setlength{\rightmargin}{0pt}%
  }%
  \item\relax
  \color{Gray}%
  \ifstrempty{#1}{}{\textbf{\color{quotebarcolor}#1}\par\smallskip}%
  \itshape
}{%
  \end{list}%
  \medskip
}

% remove indent
\setlength{\parindent}{0pt}

